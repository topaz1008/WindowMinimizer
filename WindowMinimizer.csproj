<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Explicitly set the application icon generated by the build script -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Title>Window Minimizer</Title>
    <Description>Global hook to minimize the foreground window using F24.</Description>
    <RootNamespace>WindowMinimizer</RootNamespace>
  </PropertyGroup>
</Project>
